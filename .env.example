# Telegram bot: photo loader for the vision classifier
TELEGRAM_BOT_TOKEN=
# Optional: local Bot API server must match the token that minted file_ids.
TELEGRAM_API_BASE=https://api.telegram.org

# Text classifier: TypeSafe Jev router on OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=typesafe/jev-router

# Vision classifier: Z.AI GLM (photos)
ZAI_API_KEY=
ZAI_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-4.6v

DUCKDB_PATH=./data/antispam.duckdb

# Optional tuning. Defaults are shown.
SPAM_THRESHOLD=0.81
CLASSIFIER_TIMEOUT_MS=15000
# Persistent positive verdict cache (stored in the DuckDB file); false disables only cache.
SPAM_CACHE_ENABLED=true

# Optional shadow classifier: same requests, verdict logged as `shadow_analyzed`, never deletes.
SHADOW_MODEL=
SHADOW_TIMEOUT_MS=30000

# Opt-in: store classifier requests (incl. message/profile text) + answers for distillation; pruned after N days.
TRAINING_CAPTURE=false
TRAINING_CAPTURE_DAYS=30

# Identity screening: joins/renames checked for promo profiles, admin/support
# impersonation and spam avatars (uses the same ZAI vision model + OpenRouter Jev).
IDENTITY_SCREENING=true
